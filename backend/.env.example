# Скопируйте этот файл в .env и впишите свой ключ (файл .env в git не попадает)

# Ключ с https://openrouter.ai/keys (бесплатный, карта не нужна)
OPENROUTER_API_KEY=

# Секрет для подписи токенов входа (любая длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string

# Какие сайты могут обращаться к серверу (через запятую). * = любые
CORS_ORIGINS=*

# Необязательно: по умолчанию сервер сам выбирает актуальные бесплатные модели.
# Чтобы зафиксировать свой список моделей в формате  ключ|Название|id_модели_на_openrouter  через ;
# Бесплатные модели смотрите на https://openrouter.ai/models?max_price=0
# OPENROUTER_MODELS=m1|Llama 3.3 70B|meta-llama/llama-3.3-70b-instruct:free;m2|Gemma 3 27B|google/gemma-3-27b-it:free
